# Скопіюйте у .env, щоб перевизначити налаштування. Без .env працюють значення нижче.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fields

# Порти, які публікуються на хост. Змініть, якщо 5432 або 8000 уже зайняті.
POSTGRES_PORT=5432
API_PORT=8000

# Потрібен лише для запуску застосунку поза Docker: у docker-compose він
# складається автоматично з POSTGRES_* і вказує на хост db.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fields
